# ==============================================================================
# Voyara — AI Travel Agency Platform (Mode B Configuration)
# ==============================================================================

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Credentials (Required for Mode B cloud auth & Postgres sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-migrations

# Claude API (Anthropic SDK for AI Trip Planner)
# Can also be set directly in the in-app Settings UI by the travel agent
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-claude-api-key

# Razorpay / Stripe (Optional for live payment links)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
