# ==============================================================================
# VOYARA — Luxury AI-Powered Travel Concierge Platform
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
# Fill in your credentials. Voyara is designed with graceful degradation:
# if third-party keys are absent, high-fidelity mock services activate automatically
# with clear in-app status indicators so you can develop and test seamlessly.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APP CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Voyara Concierge"
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database, Auth, Realtime, Storage, pgvector)
# Obtain at: https://supabase.com -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_DB_PASSWORD=your-secure-db-password

# ------------------------------------------------------------------------------
# 3. ANTHROPIC CLAUDE API (Agentic Concierge, Streaming, Tool Use)
# Obtain at: https://console.anthropic.com -> API Keys
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...
# Recommended: claude-3-5-sonnet-20241022
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 4. MAPBOX GL JS (3D Terrain, Itinerary Pins, Routing)
# Obtain at: https://account.mapbox.com -> Tokens -> Default Public Token
# (Fallback: OpenStreetMap / MapLibre active automatically if empty)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91cnVzZXJuYW1lIiwiYSI6ImNs...
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/dark-v11

# ------------------------------------------------------------------------------
# 5. AMADEUS TRAVEL API (Live Flights & Luxury Hotels)
# Obtain at: https://developers.amadeus.com -> My Self-Service Workspace
# ------------------------------------------------------------------------------
AMADEUS_CLIENT_ID=your-amadeus-api-key
AMADEUS_CLIENT_SECRET=your-amadeus-api-secret
AMADEUS_ENV=test # test | production

# ------------------------------------------------------------------------------
# 6. WEATHER API (Real-time forecasts & severe alerts)
# Obtain at: https://openweathermap.org/api -> One Call API 3.0 / Current Weather
# ------------------------------------------------------------------------------
OPENWEATHER_API_KEY=your-openweather-api-key

# ------------------------------------------------------------------------------
# 7. CURRENCY EXCHANGE RATE API
# Obtain at: https://www.exchangerate-api.com (Free tier: 1,500 req/mo)
# ------------------------------------------------------------------------------
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key

# ------------------------------------------------------------------------------
# 8. PLACES & ATTRACTIONS (Google Places or OpenTripMap)
# Obtain at: https://console.cloud.google.com -> Places API (New)
# Or OpenTripMap: https://opentripmap.io/product
# ------------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=your-google-places-key
OPENTRIPMAP_API_KEY=your-opentripmap-key

# ------------------------------------------------------------------------------
# 9. ENCRYPTION & SECURITY (AES-256 for Passport & Sensitive Vault Data)
# Generate a 32-byte hexadecimal key:
#   openssl rand -hex 32
# ------------------------------------------------------------------------------
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CRON_SECRET=super-secret-bearer-token-for-pgcron-verification

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY & ANALYTICS (Optional for dev)
# Sentry: https://sentry.io | PostHog: https://posthog.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
